# Copy to .env and edit. NEVER commit .env.
SECRET_KEY=replace-with-a-long-random-string
TOKEN_TTL_HOURS=12
# Default: SQLite file in ./data (single PC). For PostgreSQL install `pip install psycopg[binary]` and use e.g.:
# DATABASE_URL=postgresql+psycopg://restaurant:password@localhost:5432/restaurant
# DATABASE_URL=sqlite:///D:/path/to/restaurant.db
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
MAX_UPLOAD_MB=15
# Optional AI-assisted PDF reading (off by default; output is always a draft needing human review)
GEMINI_ENABLED=false
GEMINI_API_KEY=
